# Copy to .env and fill in. Never commit .env.

HOST=0.0.0.0
# Must be in 1-65535; anything else fails at startup rather than at bind time.
PORT=5000
# Pairing DEBUG=True with HOST=0.0.0.0 exposes the interactive debugger and warns.
DEBUG=False

MODEL_NAME=distilbert-base-uncased-finetuned-sst-2-english
MAX_LENGTH=512

# Clients must send this as the X-API-Key header. Leave unset -- or set it to
# an empty value -- to disable auth entirely.
API_KEY=change-me

RATELIMIT_ENABLED=True
